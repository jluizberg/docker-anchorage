{
  "postgres": {
    "host": "${POSTGRES_APP_INTRA_PATH}",
    "port": 5432,
    "user": "${WEBSEARCH_DB_USER}",
    "password": "${WEBSEARCH_DB_PASSWORD}",
    "database": "${WEBSEARCH_DB_NAME}"
  },
  "qdrant": {
    "url": "https://${QDRANT_APP_INTRA_PATH}",
    "apiKey": "${QDRANT_API_KEY}"
  },
  "discovery": {
    "tavilyApiKey": "${WEBSEARCH_TAVILY_API_KEY}",
    "googleApiKey": "${WEBSEARCH_GOOGLE_API_KEY}",
    "googleCx": "${WEBSEARCH_GOOGLE_CX}"
  },
  "translation": {
    "enabled": true,
    "endpoint": "http://${TRANSLATOR_CONTAINER_NAME}:5000/translate",
    "targetLanguage": "en",
    "apiKey": "${TRANSLATOR_API_KEY}"
  },
  "scheduler": {
  },
  "scraper": {
    "manualMode": true,
    "usePuppeteerSites": []
  },
  "web": {
    "apiPort": 4000,
    "scraperPort": 3001
  }
}
