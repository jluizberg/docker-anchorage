GLOBAL_PUBLIC_DOMAIN=jbdesign.com.br
GLOBAL_INTRA_DOMAIN=intra.${GLOBAL_PUBLIC_DOMAIN}

GLOBAL_DATA_DIR=/data
GLOBAL_BRIDGED_NETWORK=internal

GLOBAL_SSL_DIR=${GLOBAL_DATA_DIR}/ssl
GLOBAL_JBDESIGN_CERTS_DIR=${GLOBAL_SSL_DIR}/letsencrypt/live/jbdesign.com.br
GLOBAL_CERTIFICATE_GROUP=cert-users

LETSENCRYPT_CERTIFICATES_DIR=/etc/letsencrypt
LETSENCRYPT_CERT_FILE=fullchain.pem
LETSENCRYPT_CERT_KEY=privkey.pem

NGINX_DATA_DIR=${GLOBAL_DATA_DIR}/nginx
NGINX_BASE_DIR=/etc/nginx
NGINX_CERTS_DIR=/ssl/certs

PROGET_DATA_DIR=${GLOBAL_DATA_DIR}/proget
PROGET_APP_INTRA_PATH=proget.${GLOBAL_INTRA_DOMAIN}
PROGET_APP_PUBLIC_PATH=proget.${GLOBAL_PUBLIC_DOMAIN}
PROGET_CONTAINER_NAME=proget

RANCHER_DATA_DIR=${GLOBAL_DATA_DIR}/rancher
RANCHER_APP_INTRA_PATH=rancher.${GLOBAL_INTRA_DOMAIN}
RANCHER_APP_PUBLIC_PATH=rancher.${GLOBAL_PUBLIC_DOMAIN}
RANCHER_CONTAINER_NAME=rancher

