GLOBAL_PUBLIC_DOMAIN=jbdesign.com.br
GLOBAL_INTRA_DOMAIN=intra.jbdesign.com.br

GLOBAL_DATA_DIR=/data
GLOBAL_BRIDGED_NETWORK=internal

GLOBAL_SSL_DIR=/data/ssl
GLOBAL_JBDESIGN_CERTS_DIR=/data/ssl/letsencrypt/live/jbdesign.com.br
GLOBAL_CERTIFICATE_GROUP=cert-users

LETSENCRYPT_CERTIFICATES_DIR=/etc/letsencrypt
LETSENCRYPT_CERT_FILE=fullchain.pem
LETSENCRYPT_CERT_KEY=privkey.pem

NGINX_DATA_DIR=/data/nginx
NGINX_BASE_DIR=/etc/nginx
NGINX_CERTS_DIR=/ssl/certs

PROGET_DATA_DIR=/data/proget
PROGET_APP_INTRA_PATH=proget.intra.jbdesign.com.br
PROGET_APP_PUBLIC_PATH=proget.jbdesign.com.br
PROGET_CONTAINER_NAME=proget

RANCHER_DATA_DIR=/data/rancher
RANCHER_APP_INTRA_PATH=rancher.intra.jbdesign.com.br
RANCHER_APP_PUBLIC_PATH=rancher.jbdesign.com.br
RANCHER_CONTAINER_NAME=rancher

